{
  "name": "eirvio",
  "version": "0.3.1",
  "description": "Let agents act in your interface and stay aware of user interactions through declared events and guarded actions.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./packages/sdk/src/index.d.mts",
      "import": "./packages/sdk/src/index.mjs"
    },
    "./host": {
      "types": "./packages/sdk/src/host.d.mts",
      "import": "./packages/sdk/src/host.mjs"
    },
    "./core": {
      "types": "./packages/core/src/index.d.mts",
      "import": "./packages/core/src/index.mjs"
    },
    "./contracts/*": "./packages/core/contracts/*",
    "./web": {
      "types": "./packages/sdk/src/web.d.mts",
      "import": "./packages/sdk/src/web.mjs"
    },
    "./babylon": {
      "types": "./packages/sdk/src/babylon.d.mts",
      "import": "./packages/sdk/src/babylon.mjs"
    }
  },
  "files": [
    "packages/sdk/src",
    "packages/core/src",
    "packages/core/contracts",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test packages/core/test/*.test.mjs packages/sdk/test/*.test.mjs test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "demo": "node examples/task-board/demo.mjs",
    "start": "node examples/task-board/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.babylon.json",
    "build:demo": "node scripts/build-demo.mjs",
    "prestart": "npm run build:demo",
    "lab:test": "node lab/run.mjs testing",
    "lab:learn": "node lab/run.mjs learning",
    "lab:serve": "node lab/server.mjs"
  },
  "keywords": [
    "agents",
    "user-interface",
    "interaction",
    "events",
    "sdk",
    "runtime"
  ],
  "devDependencies": {
    "@babylonjs/core": "8.26.0",
    "esbuild": "0.25.11",
    "jsdom": "27.1.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pineapulse/eirvio.git"
  },
  "homepage": "https://github.com/Pineapulse/eirvio#readme",
  "bugs": {
    "url": "https://github.com/Pineapulse/eirvio/issues"
  }
}
